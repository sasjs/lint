{
  "compilerOptions": {
      "lib": [
          "ES2018",
          "DOM",
          "ES2019.String"
      ],
      "target": "es6",
      "module": "node16",
      "moduleResolution": "node16",
      "esModuleInterop": true,
      "declaration": true,
      "outDir": "./build",
      "rootDir": "./src",
      "strict": true,
      "sourceMap": true,
      "isolatedModules": true,
      "types": ["jest", "node"]
  },
  "include": [
      "src"
  ],
  "exclude": [
      "node_modules",
      "**/*.spec.ts",
      "**/example.ts"
  ]
}
